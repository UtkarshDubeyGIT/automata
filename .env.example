# ============================================================
# Automata environment configuration
# Copy to `.env.local` and fill in required keys.
# ============================================================

# ---- App host ----
APP_HOST=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Automata

# ---- Supabase (auth + database + storage) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ---- OpenAI (content, reasoning, workflow AI builder & steps) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TRENDS_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Stripe (subscriptions + credits) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# ---- Composio (social connect + integrations catalog) ----
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

# Composio / Shopify OAuth
COMPOSIO_OAUTH_SHOPIFY_CLIENT_ID=
COMPOSIO_OAUTH_SHOPIFY_CLIENT_SECRET=
COMPOSIO_OAUTH_SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory,read_fulfillments,read_locations

# ---- Twilio WhatsApp workflow reminders & verification ----
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_SANDBOX=true
TWILIO_VERIFY_SERVICE_SID=
TWILIO_CONTENT_SID_GENERIC_ALERT=
TWILIO_CONTENT_SID_SCHEDULED_DIGEST=
TWILIO_CONTENT_SID_REMINDER=

# ---- Firecrawl (web search, scrape, crawl & agent in workflows) ----
FIRECRAWL_API_KEY=

# ---- Linkup (web search fallback) ----
LINKUP_API_KEY=

# ---- Google Business API Profile Credentials ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ---- Credential encryption (AES-256-GCM) ----
CREDENTIAL_ENCRYPTION_KEY=

# ---- Higgsfield (AI video generation in workflows) ----
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# ---- Resend (transactional email & approvals) ----
RESEND_API_KEY=
RESEND_FROM=Automata <noreply@automata.internal>
EMAIL_FROM=Automata <noreply@automata.internal>

# ---- Unattended worker & cron ----
CRON_SECRET=
WORKER_POLL_MS=15000

# ---- Automata internal keys & brand ----
AUTOMATA_SECRET_KEY=
AUTOMATA_WEBHOOK_KEY=
NEXT_PUBLIC_APP_NAME=Automata
NEXT_PUBLIC_SUPPORT_EMAIL=support@automata.internal
